# ── Lokal (./run.sh) ───────────────────────────────────────────
DATABASE_URL=postgres://localhost/db_rekap_kost
PORT=3000

# ── Deploy (server online) ─────────────────────────────────────
# Contoh DATABASE_URL di server: postgres://carko:KATA_SANDI_DB@localhost:5432/carko
# Terima koneksi dari luar (di belakang Caddy/Nginx cukup 127.0.0.1)
# HOST=127.0.0.1
# Akun login disimpan di database (tabel pengguna). Akun awal: dinda / dandiluv.
# Kelola dengan: npm run akun -- daftar | tambah <username> | sandi <username> | hapus <username>

# ── Opsional ───────────────────────────────────────────────────
# Folder salinan foto (default ./data/foto)
# FOTO_DIR=
# Jarak & rute sama dengan Google Maps mode motor (Google Routes API). Kosong = pakai OpenStreetMap.
GOOGLE_MAPS_KEY=
