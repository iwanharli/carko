# Konfigurasi ./deploy.sh — salin ke .env.deploy (tidak ikut git) lalu isi.
DEPLOY_HOST=root@IP-SERVER
DEPLOY_DIR=/var/www/carko
PM2_NAME=carko-8041
PORT_SERVER=8041
DEPLOY_URL=https://carko.kecup.in
# Kosongkan bila memakai SSH key (disarankan). Bila diisi, deploy memakai sshpass.
DEPLOY_PASSWORD=
